#!/bin/zsh
# novel — Meaw Meaw Read command line
#
#   ./novel scan [ไฟล์.pdf … | โฟลเดอร์]   แปลง PDF (ภาพสแกนหรือไม่ก็ได้) เป็นหนังสือ แล้วขึ้น GitHub
#                                         ไม่ระบุไฟล์ = แปลงทุกไฟล์ในโฟลเดอร์ "สแกน"
#   ./novel list                          ดูหนังสือบนชั้น
#   ./novel remove <ชื่อหนังสือ>            เอาเล่มออกจากชั้น แล้วขึ้น GitHub
#   ./novel push                          ส่งการเปลี่ยนแปลงทั้งหมดขึ้น GitHub
#   ./novel password                      เปลี่ยนรหัสเข้าเว็บ (เข้ารหัสหนังสือทุกเล่มใหม่)
#   ./novel token                         ใส่กุญแจ GitHub ร่วม ให้ทุกอุปกรณ์ที่ใส่รหัสเว็บได้ เพิ่ม/ลบหนังสือได้
#   ./novel open                          เปิดหน้าเว็บ
#
# หนังสือที่อ่านได้อยู่ใน library/ บนเครื่องนี้เท่านั้น ที่ขึ้น GitHub (books/) เป็นไฟล์เข้ารหัสด้วยรหัสเว็บ
# รหัสเก็บใน Keychain ของ Mac  ·  ตั้ง NOVEL_NO_PUSH=1 ถ้าไม่อยากให้ขึ้น GitHub อัตโนมัติ
# การแปลงทำบนเครื่องนี้ทั้งหมดด้วย Apple Vision — ฟรี ไม่ใช้ claude.ai

set -e
ROOT="${0:A:h}"
cd "$ROOT"
BIN="tools/.bin/thai-ocr"
LIB="library"      # readable books, never pushed
BOOKS="books"      # encrypted copies for the website
VAULT="tools/vault.json"
KEYCHAIN=(-s meaw-meaw-read -a novel)
KEYCHAIN_GH=(-s meaw-meaw-read-gh -a novel)
mkdir -p "$LIB" "$BOOKS" "สแกน" "tools/.bin"

build() {
  if [[ ! -x "$BIN" || "tools/thai-ocr.swift" -nt "$BIN" ]]; then
    echo "กำลังเตรียมตัวแปลง (ครั้งแรกใช้เวลาราวครึ่งนาที)…"
    swiftc -O "tools/thai-ocr.swift" -o "$BIN" || {
      echo "เตรียมตัวแปลงไม่สำเร็จ ต้องมี Xcode Command Line Tools:  xcode-select --install" >&2; exit 1; }
  fi
}

site_password() {
  security find-generic-password $KEYCHAIN -w 2>/dev/null || {
    echo "ยังไม่ได้ตั้งรหัสเว็บในเครื่องนี้ — ตั้งด้วย ./novel password" >&2; exit 1; }
}

sync_down() {  # get books other devices added on the website
  [[ -n "$NOVEL_NO_PUSH" ]] && return
  git rev-parse --git-dir >/dev/null 2>&1 || return
  git pull -q --rebase --autostash 2>/dev/null || echo "ดึงข้อมูลล่าสุดจาก GitHub ไม่ได้ (ทำต่อด้วยข้อมูลในเครื่อง)" >&2
}

publish() {   # publish "<commit message>" [name of a book being removed]
  sync_down
  local extra=(); [[ -n "$2" ]] && extra=(--drop "$2")
  NOVEL_PASSWORD="$(site_password)" "$BIN" --seal "$LIB" "$BOOKS" "$VAULT" "${extra[@]}"
  if [[ -n "$NOVEL_NO_PUSH" ]]; then echo "ข้ามการขึ้น GitHub (NOVEL_NO_PUSH)"; return; fi
  if ! git rev-parse --git-dir >/dev/null 2>&1; then echo "โฟลเดอร์นี้ยังไม่ได้เชื่อม GitHub" >&2; return; fi
  git add -A
  if git diff --cached --quiet; then echo "ไม่มีอะไรเปลี่ยน"; return; fi
  git commit -q -m "$1"
  echo "กำลังส่งขึ้น GitHub…"
  if git push -q; then echo "✓ ขึ้น GitHub แล้ว"; else echo "✗ ส่งขึ้น GitHub ไม่สำเร็จ ลองใหม่ด้วย ./novel push" >&2; fi
}

cmd="${1:-help}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
  scan|แปลง)
    build
    [[ $# -eq 0 ]] && set -- "สแกน"
    titles=()
    for src in "$@"; do
      if [[ -d "$src" && -z "$(ls "$src"/*.(pdf|PDF)(N) 2>/dev/null)" ]]; then echo "ไม่มีไฟล์ PDF ใน $src"; continue; fi
      "$BIN" "$src" "$LIB"
      if [[ -d "$src" ]]; then for f in "$src"/*.(pdf|PDF)(N); do titles+=("${f:t:r}"); done; else titles+=("${src:t:r}"); fi
    done
    (( ${#titles} )) && publish "เพิ่มหนังสือ: ${(j:, :)titles}"
    ;;
  list|ls)
    build; sync_down
    NOVEL_PASSWORD="$(site_password)" "$BIN" --seal "$LIB" "$BOOKS" "$VAULT" >/dev/null
    n=0
    for f in "$LIB"/*.book.json(N); do echo "  • ${${f:t}%.book.json}"; n=$((n+1)); done
    echo "รวม $n เล่ม"
    ;;
  remove|rm)
    [[ -z "$1" ]] && { echo "ระบุชื่อหนังสือ เช่น ./novel remove \"ชื่อเรื่อง\""; exit 1; }
    build
    sync_down
    NOVEL_PASSWORD="$(site_password)" "$BIN" --seal "$LIB" "$BOOKS" "$VAULT" >/dev/null   # pick up books added on the web
    [[ -f "$LIB/$1.book.json" ]] || { echo "ไม่พบ \"$1\" บนชั้น (ดูรายชื่อด้วย ./novel list)"; exit 1; }
    rm -f "$LIB/$1.book.json" "$LIB/$1.cover.jpg"
    publish "เอาออกจากชั้น: $1" "$1"
    ;;
  push)
    build; publish "อัปเดตชั้นหนังสือ"
    ;;
  password|รหัส)
    build
    read -rs "pw1?รหัสใหม่: "; echo
    read -rs "pw2?พิมพ์รหัสอีกครั้ง: "; echo
    [[ -z "$pw1" ]] && { echo "รหัสว่างไม่ได้"; exit 1; }
    [[ "$pw1" != "$pw2" ]] && { echo "รหัสสองครั้งไม่ตรงกัน"; exit 1; }
    security add-generic-password -U $KEYCHAIN -l "Meaw Meaw Read" -w "$pw1"
    NOVEL_PASSWORD="$pw1" NOVEL_GH_TOKEN="$(security find-generic-password $KEYCHAIN_GH -w 2>/dev/null)" "$BIN" --vault "$VAULT" index.html
    publish "เปลี่ยนรหัสเว็บ"
    ;;
  token|กุญแจ)
    build
    repo=$(git remote get-url origin 2>/dev/null | sed -E 's#.*github\.com[:/]##; s#\.git$##')
    [[ -z "$repo" ]] && { echo "โฟลเดอร์นี้ยังไม่ได้เชื่อม GitHub"; exit 1; }
    echo "สร้างกุญแจที่ https://github.com/settings/personal-access-tokens/new"
    echo "  • Repository access: Only select repositories → $repo"
    echo "  • Permissions → Repository → Contents: Read and write"
    echo "  • ตั้งวันหมดอายุตามสะดวก (หมดอายุแล้วรัน ./novel token ใหม่)"
    if [[ -n "$NOVEL_TOKEN_DIALOG" ]]; then
      # a normal Mac pop-up with a paste box (easier than typing into Terminal)
      tok=$(osascript -e 'text returned of (display dialog "วางกุญแจ GitHub ที่คัดลอกมา (ขึ้นต้นด้วย github_pat_) แล้วกด OK" default answer "" with hidden answer with title "Meaw Meaw Read – กุญแจร่วม" buttons {"ยกเลิก", "OK"} default button "OK" cancel button "ยกเลิก")' 2>/dev/null) || { echo "ยกเลิกแล้ว"; exit 1; }
      tok="${tok//[[:space:]]/}"
      [[ -z "$tok" ]] && { echo "ยังไม่ได้วางกุญแจ"; exit 1; }
    else
      read -rs "tok?วางกุญแจ GitHub (ไม่แสดงบนจอ, เว้นว่างเพื่อเอากุญแจร่วมออก): "; echo
    fi
    if [[ -n "$tok" ]]; then
      ok=$(printf 'Authorization: Bearer %s\n' "$tok" | curl -s -H @- "https://api.github.com/repos/$repo" \
           | python3 -c 'import json,sys; print(json.load(sys.stdin).get("permissions",{}).get("push",False))' 2>/dev/null)
      [[ "$ok" != "True" ]] && { echo "กุญแจนี้เขียน $repo ไม่ได้ ตรวจสิทธิ์ Contents: Read and write แล้วลองใหม่"; exit 1; }
      security add-generic-password -U $KEYCHAIN_GH -l "Meaw Meaw Read GitHub" -w "$tok"
    else
      security delete-generic-password $KEYCHAIN_GH >/dev/null 2>&1 || true
    fi
    NOVEL_PASSWORD="$(site_password)" NOVEL_GH_TOKEN="$tok" NOVEL_REPO="$repo" "$BIN" --token "$VAULT" index.html
    publish "อัปเดตกุญแจร่วมของชั้นออนไลน์"
    ;;
  open)
    url=$(gh api "repos/{owner}/{repo}/pages" --jq .html_url 2>/dev/null) || true
    if [[ -n "$url" ]]; then open "$url"; else echo "ยังไม่ได้เปิด GitHub Pages — เปิดไฟล์ index.html ในเครื่องแทน"; open index.html; fi
    ;;
  *)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
